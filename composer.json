{
    "name": "mgomezbuceta/cakephp-aclmanager",
    "description": "Modern Authorization Manager for CakePHP 5.x - Role-based permission management system",
    "keywords": ["cakephp", "cakephp5", "cake5", "plugin", "authorization", "manager", "permissions", "rbac", "roles"],
    "homepage": "https://github.com/mgomezbuceta/cakephp-aclmanager",
    "type": "cakephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcos Gómez Buceta",
            "email": "mgomezbuceta@gmail.com",
            "homepage": "https://github.com/mgomezbuceta",
            "role": "Maintainer"
        },
        {
            "name": "Ivan Amat",
            "homepage": "http://www.ivanamat.es",
            "role": "Original Author"
        }
    ],
    "require": {
        "php": ">=8.1",
        "cakephp/cakephp": "^5.0",
        "cakephp/authorization": "^3.0"
    },
    "suggest": {
        "cakephp/authentication": "Identifies the current user; without it the manager returns 403 unless allowWithoutAuthentication is enabled",
        "cakephp/migrations": "^4.5 || ^5.0. Needed to create the tables with 'bin/cake migrations migrate -p AclManager' (the SQL in docs/sql works without it)"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "cakephp/cakephp-codesniffer": "^5.0",
        "cakephp/authentication": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "AclManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AclManager\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
