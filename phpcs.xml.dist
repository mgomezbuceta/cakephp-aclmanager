<?xml version="1.0"?>
<ruleset name="AclManager">
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <file>src</file>
    <file>config</file>
    <file>templates</file>
    <file>tests</file>

    <exclude-pattern>*/tmp/*</exclude-pattern>
    <exclude-pattern>*/logs/*</exclude-pattern>

    <rule ref="CakePHP"/>
</ruleset>
