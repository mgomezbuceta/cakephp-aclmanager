# General
msgid "Authorization Manager"
msgstr "Xestor de Autorizacións"

msgid "Dashboard"
msgstr "Panel de Control"

msgid "Roles"
msgstr "Roles"

msgid "Sync Resources"
msgstr "Sincronizar Recursos"

msgid "Back to App"
msgstr "Volver á Aplicación"

msgid "Actions"
msgstr "Accións"

msgid "Status"
msgstr "Estado"

msgid "Active"
msgstr "Activo"

msgid "Inactive"
msgstr "Inactivo"

msgid "Created"
msgstr "Creado"

# Dashboard
msgid "Manage Roles & Permissions"
msgstr "Xestionar Roles e Permisos"

msgid "Overview of all roles and their permissions"
msgstr "Vista xeral de todos os roles e os seus permisos"

msgid "Role"
msgstr "Rol"

msgid "Name"
msgstr "Nome"

msgid "Description"
msgstr "Descrición"

msgid "Priority"
msgstr "Prioridade"

msgid "Permissions"
msgstr "Permisos"

msgid "Manage Permissions"
msgstr "Xestionar Permisos"

msgid "Edit"
msgstr "Editar"

msgid "Delete"
msgstr "Eliminar"

msgid "New Role"
msgstr "Novo Rol"

msgid "Total Resources"
msgstr "Total de Recursos"

msgid "No roles found"
msgstr "Non se atoparon roles"

msgid "Get started by creating your first role."
msgstr "Comeza creando o teu primeiro rol."

msgid "Create First Role"
msgstr "Crear Primeiro Rol"

# Role Form
msgid "Add Role"
msgstr "Engadir Rol"

msgid "Edit Role"
msgstr "Editar Rol"

msgid "Create a new role for your application"
msgstr "Crear un novo rol para a túa aplicación"

msgid "Update role information"
msgstr "Actualizar información do rol"

msgid "Role Information"
msgstr "Información do Rol"

msgid "e.g., Administrator, Editor, Viewer"
msgstr "ex., Administrador, Editor, Visualizador"

msgid "Brief description of this role and its purpose"
msgstr "Breve descrición deste rol e o seu propósito"

msgid "Higher priority roles have precedence. Range: 0-100"
msgstr "Os roles de maior prioridade teñen precedencia. Rango: 0-100"

msgid "Save Role"
msgstr "Gardar Rol"

msgid "Cancel"
msgstr "Cancelar"

msgid "Quick Actions"
msgstr "Accións Rápidas"

msgid "Clear All Permissions"
msgstr "Limpar Todos os Permisos"

msgid "Are you sure you want to clear all permissions for this role?"
msgstr "Estás seguro de que queres limpar todos os permisos deste rol?"

msgid "Role created successfully."
msgstr "Rol creado correctamente."

msgid "Unable to create role. Please try again."
msgstr "Non se puido crear o rol. Por favor, téntao de novo."

msgid "Role updated successfully."
msgstr "Rol actualizado correctamente."

msgid "Unable to update role. Please try again."
msgstr "Non se puido actualizar o rol. Por favor, téntao de novo."

msgid "Role deleted successfully."
msgstr "Rol eliminado correctamente."

msgid "Unable to delete role. Please try again."
msgstr "Non se puido eliminar o rol. Por favor, téntao de novo."

msgid "Are you sure you want to delete {0}?"
msgstr "Estás seguro de que queres eliminar {0}?"

# Permissions Management
msgid "Manage Permissions for {0}"
msgstr "Xestionar Permisos para {0}"

msgid "Role: {0}"
msgstr "Rol: {0}"

msgid "Back"
msgstr "Volver"

msgid "Save Permissions"
msgstr "Gardar Permisos"

msgid "Clear All"
msgstr "Limpar Todo"

msgid "Action"
msgstr "Acción"

msgid "Permission"
msgstr "Permiso"

msgid "Allow"
msgstr "Permitir"

msgid "Please select a role."
msgstr "Por favor, selecciona un rol."

msgid "Permissions saved successfully. {0} permissions granted."
msgstr "Permisos gardados correctamente. {0} permisos concedidos."

msgid "The permissions could not be saved. Check the application log for details."
msgstr "Non se puideron gardar os permisos. Consulta o rexistro da aplicación para ver máis detalles."

msgid "No resources found. Please run \"Sync Resources\" first."
msgstr "Non se atoparon recursos. Por favor, executa \"Sincronizar Recursos\" primeiro."

msgid "All permissions cleared for role \"{0}\". {1} permissions removed."
msgstr "Todos os permisos limpados para o rol \"{0}\". {1} permisos eliminados."

msgid "The permissions could not be cleared. Check the application log for details."
msgstr "Non se puideron eliminar os permisos. Consulta o rexistro da aplicación para ver máis detalles."

# Sync Resources
msgid "Resources synchronized. Found: {0}, Created: {1}, Updated: {2}, Deactivated: {3}"
msgstr "Recursos sincronizados. Atopados: {0}, Creados: {1}, Actualizados: {2}, Desactivados: {3}"

msgid "The resources could not be synchronized. Check the application log for details."
msgstr "Non se puideron sincronizar os recursos. Consulta o rexistro da aplicación para ver máis detalles."

# Copy Permissions
msgid "Invalid roles specified."
msgstr "Roles especificados non válidos."

msgid "Source and target roles must be different."
msgstr "Os roles de orixe e destino deben ser distintos."

msgid "Permissions copied successfully from \"{0}\" to \"{1}\"."
msgstr "Permisos copiados correctamente de \"{0}\" a \"{1}\"."

msgid "Error copying permissions."
msgstr "Erro ao copiar permisos."

msgid "The permissions could not be copied. Check the application log for details."
msgstr "Non se puideron copiar os permisos. Consulta o rexistro da aplicación para ver máis detalles."

msgid "Invalid role specified."
msgstr "Rol especificado non válido."

# Access Control
msgid "You must be logged in to access the Authorization Manager."
msgstr "Debes iniciar sesión para acceder ao Xestor de Autorizacións."

msgid "You do not have permission to access the Authorization Manager."
msgstr "Non tes permiso para acceder ao Xestor de Autorizacións."

# Misc
msgid "ID"
msgstr "ID"

msgid "Select All"
msgstr "Seleccionar Todo"

msgid "Deselect All"
msgstr "Deseleccionar Todo"

# Additional strings
msgid "Total Roles"
msgstr "Total de Roles"

msgid "Total Permissions"
msgstr "Total de Permisos"

msgid "Manage Roles"
msgstr "Xestionar Roles"

msgid "Create and manage user roles"
msgstr "Crear e xestionar roles de usuario"

msgid "Back to Dashboard"
msgstr "Volver ao Panel de Control"

msgid "Deny"
msgstr "Deny"

msgid "The form data was incomplete (check the PHP max_input_vars setting). No permissions were changed."
msgstr "Os datos do formulario estaban incompletos (revisa a configuración max_input_vars de PHP). Non se modificou ningún permiso."

msgid "The form was missing its version token. No permissions were changed; reload the page and try again."
msgstr "Ao formulario faltáballe o token de versión. Non se modificou ningún permiso; recarga a páxina e téntao de novo."

msgid "Another administrator changed the permissions of this role while you were editing. The page has been reloaded with the current data; apply your changes again."
msgstr "Outro administrador cambiou os permisos deste rol mentres os editabas. A páxina recargouse cos datos actuais; volve aplicar os teus cambios."

msgid "Administrator roles cannot be deleted."
msgstr "Os roles de administrador non se poden eliminar."

msgid "Administrator roles cannot be deactivated."
msgstr "Os roles de administrador non se poden desactivar."

msgid "The Authentication component is not available. Configure cakephp/authentication or set AclManager.adminAccess.allowWithoutAuthentication."
msgstr "O compoñente Authentication non está dispoñible. Configura cakephp/authentication ou establece AclManager.adminAccess.allowWithoutAuthentication."

msgid "You are not authorized to access that location."
msgstr "Non tes autorización para acceder a esa localización."
